/**
 * Shortcode: [ilocker_addresses]
 * Description: Affiche une grille moderne pour les adresses de Facturation et Livraison.
 */

add_shortcode('ilocker_addresses', function() {
    if (!is_user_logged_in()) return '';
    
    $customer_id = get_current_user_id();
    
    // Définition des titres et clés WooCommerce
    $types = [
        'billing'  => 'Adresse de Facturation', 
        'shipping' => 'Adresse de Livraison'
    ];
    
    ob_start(); ?>
    
    <div class="il-dashboard-card il-addr-wrapper">
        <h3 class="il-card-title">Mes Adresses</h3>
        <p class="il-card-desc">Gérez vos lieux de livraison et de facturation par défaut.</p>

        <div class="il-addr-grid">
            <?php foreach ($types as $name => $title): 
                $address = wc_get_account_formatted_address($name);
                $edit_url = wc_get_endpoint_url('edit-address', $name);
                $has_addr = $address ? true : false;
            ?>
            <div class="il-addr-box">
                <div class="il-addr-header">
                    <span class="il-addr-badge"><?php echo ($name === 'billing') ? 'Facturation' : 'Livraison'; ?></span>
                    <a href="<?php echo esc_url($edit_url); ?>" class="il-btn-icon-edit" title="Modifier">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    </a>
                </div>
                
                <div class="il-addr-content">
                    <?php if ($has_addr): ?>
                        <address><?php echo wp_kses_post($address); ?></address>
                    <?php else: ?>
                        <div class="il-addr-empty">
                            <span>Pas encore définie.</span>
                            <a href="<?php echo esc_url($edit_url); ?>">Ajouter</a>
                        </div>
                    <?php endif; ?>
                </div>
            </div>
            <?php endforeach; ?>
        </div>
    </div>

    <?php return ob_get_clean();
});