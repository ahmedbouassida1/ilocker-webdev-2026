/**
 * iLocker Orders Interface (Standalone)
 * Shortcode: [ilocker_orders]
 * Style: Hérite des variables globales + CSS spécifique ci-dessous.
 */

add_shortcode('ilocker_orders', function() {
    if (!is_user_logged_in()) return '';

    // Récupération des commandes
    $customer_id = get_current_user_id();
    $paged = (get_query_var('paged')) ? get_query_var('paged') : 1;
    
    $args = [
        'customer' => $customer_id,
        'limit'    => 10,
        'page'     => $paged,
        'paginate' => true,
    ];
    $orders = wc_get_orders($args);

    ob_start(); 
    ?>

    <div class="il-dashboard-card">
        
        <?php if (!$orders || empty($orders->orders)): ?>
            
            <div class="il-empty-state">
                <div style="font-size:40px; margin-bottom:10px;">📦</div>
                <p style="color:var(--text-secondary);">Aucune commande trouvée.</p>
                <a href="<?php echo wc_get_page_permalink('shop'); ?>" class="il-btn-link">Aller à la boutique</a>
            </div>

        <?php else: ?>

            <div class="il-table-responsive">
                <table class="il-custom-table">
                    <thead>
                        <tr>
                            <th>Commande</th>
                            <th class="il-hide-mobile">Date</th>
                            <th>État</th>
                            <th class="il-hide-mobile">Total</th>
                            <th style="text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($orders->orders as $order): 
                            $status_slug = $order->get_status();
                            $status_name = wc_get_order_status_name($status_slug);
                        ?>
                        <tr>
                            <td>
                                <a href="<?php echo $order->get_view_order_url(); ?>" class="il-order-link">
                                    #<?php echo $order->get_order_number(); ?>
                                </a>
                            </td>

                            <td class="il-hide-mobile" style="font-size:14px;">
                                <?php echo wc_format_datetime($order->get_date_created()); ?>
                            </td>

                            <td>
                                <span class="il-status-badge status-<?php echo $status_slug; ?>">
                                    <?php echo $status_name; ?>
                                </span>
                            </td>

                            <td class="il-hide-mobile">
                                <span style="font-weight:700; color:var(--text-primary);">
                                    <?php echo $order->get_formatted_order_total(); ?>
                                </span>
                            </td>

                            <td style="text-align:right;">
                                <a href="<?php echo $order->get_view_order_url(); ?>" class="il-btn-outline-small">
                                    VOIR
                                </a>
                            </td>
                        </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            </div>

            <?php if ($orders->max_num_pages > 1): ?>
                <div class="il-pagination">
                    <?php
                    echo paginate_links([
                        'base'    => str_replace(999999999, '%#%', esc_url(get_pagenum_link(999999999))),
                        'format'  => '?paged=%#%',
                        'current' => max(1, get_query_var('paged')),
                        'total'   => $orders->max_num_pages,
                        'prev_text' => '←',
                        'next_text' => '→',
                    ]);
                    ?>
                </div>
            <?php endif; ?>

        <?php endif; ?>
    </div>

    <?php return ob_get_clean();
});